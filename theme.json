            "units": ["%", "px", "em", "rem", "vh", "vw"]
        },
        "typography": {
            "defaultFontSizes": false,
            "fluid": {
                "minViewportWidth": "375px",
                "maxViewportWidth": "1440px"
            },
            "fontFamilies": [
                {
                    "name": "DM Sans",
                    "slug": "dm-sans",
                    "fontFamily": "\"DM Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif",
                    "fontFace": [
                        {
                            "src": ["file:./assets/fonts/dm-sans/dm-sans-latin-wght-normal.woff2"],
                            "fontWeight": "100 1000",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "fontFamily": "\"DM Sans\""
                        },
                        {
                            "src": ["file:./assets/fonts/dm-sans/dm-sans-latin-wght-italic.woff2"],
                            "fontWeight": "100 1000",
                            "fontStyle": "italic",
                            "fontDisplay": "swap",
                            "fontFamily": "\"DM Sans\""
                        }
                    ]
                },
                {
                    "name": "Manrope",
                    "slug": "manrope",
                    "fontFamily": "\"Manrope\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif",
                    "fontFace": [
                        {
                            "src": ["file:./assets/fonts/manrope/manrope-latin-wght-normal.woff2"],
                            "fontWeight": "200 800",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "fontFamily": "\"Manrope\""
                        }
                    ]
                }
            ],
            "fontSizes": [
                {
                    "name": "Heading One",
                    "size": "72px",
                    "slug": "tnys-heading-one",
                    "fluid": { "min": "40px", "max": "72px" }
                },
                {
                    "name": "Heading Two",
                    "size": "52px",
                    "slug": "tnys-heading-two",
                    "fluid": { "min": "34px", "max": "52px" }
                },
                {
                    "name": "Heading Three",
                    "size": "44px",
                    "slug": "tnys-heading-three",
                    "fluid": { "min": "30px", "max": "44px" }
                },
                {
                    "name": "Heading Four",
                    "size": "36px",
                    "slug": "tnys-heading-four",
                    "fluid": { "min": "26px", "max": "36px" }
                },
                {
                    "name": "Heading Five",
                    "size": "28px",
                    "slug": "tnys-heading-five",
                    "fluid": { "min": "22px", "max": "28px" }
                },
                {
                    "name": "Heading Six",
                    "size": "22px",
                    "slug": "tnys-heading-six",
                    "fluid": { "min": "20px", "max": "22px" }
                },
                {
                    "name": "Extra Large",
                    "size": "22px",
                    "slug": "tnys-extra-large",
                    "fluid": { "min": "18px", "max": "22px" }
                },
                {
                    "name": "Large",
                    "size": "18px",
                    "slug": "tnys-large",
                    "fluid": { "min": "16px", "max": "18px" }
                },
                {
                    "name": "Medium",
                    "size": "16px",
                    "slug": "tnys-medium",
                    "fluid": false
                },
                {
                    "name": "Small",
                    "size": "14px",
                    "slug": "tnys-small",
                    "fluid": false
                },
                {
                    "name": "Extra Small",
                    "size": "12px",
                    "slug": "tnys-extra-small",
                    "fluid": false
                }
            ],
            "writingMode": true
        },
        "layout": {
            "contentSize": "1310px",
            "wideSize": "1440px"
        },
        "shadow": {
            "defaultPresets": false,
            "presets": [
                {
                    "name": "Default Shadow",
                    "shadow": "0 0 11.5px 0 #8FA4B7",
                    "slug": "tnys-shadow"
                },
                {
                    "name": "Soft Shadow",
                    "shadow": "0 4px 20px 0 rgba(123, 123, 123, 0.25)",
                    "slug": "tnys-shadow-soft"
                }
            ]
        },
        "useRootPaddingAwareAlignments": true
    },
    "styles": {
        "blocks": {
            "core/avatar": {
                "border": {
                    "radius": "100px"
                }
            },
            "core/button": {
                "variations": {
                    "link": {
                        "border": {
                            "color": "transparent",
                            "radius": "0px",
                            "style": "none",
                            "width": "0"
                        },
                        ":hover": {
                            "color": {
                                "text": "var(--wp--preset--color--tnys-bay-of-many-light)"
                            }
                        },
                        "color": {
                            "background": "transparent",
                            "text": "#487EEC"
                        },
                        "css": "background: transparent !important;",
                        "spacing": {
                            "padding": {
                                "bottom": "0",
                                "left": "0",
                                "right": "0",
                                "top": "0"
                            }
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    },
                    "alternative": {
                        ":hover": {
                            "color": {
                                "background": "var(--wp--preset--color--tnys-bermuda)",
                                "text": "var(--wp--preset--color--tnys-bay-of-many)"
                            }
                        },
                        "color": {
                            "background": "var(--wp--preset--color--tnys-bermuda-lighter)",
                            "text": "var(--wp--preset--color--tnys-bermuda-darkest)"
                        }
                    },
                    "outline": {
                        ":hover": {
                            "border": {
                                "color": "var(--wp--preset--color--tnys-bay-of-many)"
                            },
                            "color": {
                                "background": "var(--wp--preset--color--tnys-bay-of-many-lightest)",
                                "text": "var(--wp--preset--color--tnys-bay-of-many)"
                            }
                        },
                        "border": {
                            "color": "var(--wp--preset--color--tnys-bay-of-many)",
                            "style": "solid",
                            "width": "1.5px"
                        },
                        "color": {
                            "background": "var(--wp--preset--color--tnys-white)",
                            "text": "var(--wp--preset--color--tnys-bay-of-many)"
                        }
                    }
                }
            },
            "core/buttons": {
                "spacing": {
                    "blockGap": "16px"
                }
            },
            "core/code": {
                "color": {
                    "background": "var(--wp--preset--color--tnys-neutral-lightest)",
                    "text": "var(--wp--preset--color--tnys-neutral-dark)"
                },
                "spacing": {
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--tnys-40)",
                        "left": "var(--wp--preset--spacing--tnys-40)",
                        "right": "var(--wp--preset--spacing--tnys-40)",
                        "top": "var(--wp--preset--spacing--tnys-40)"
                    }
                },
                "typography": {
                    "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
                    "fontSize": "var(--wp--preset--font-size--tnys-medium)",
                    "fontWeight": "300"
                }
            },
            "core/columns": {
                "spacing": {
                    "blockGap": "var(--wp--preset--spacing--tnys-50)"
                }
            },
            "core/comment-author-name": {
                "color": {
                    "text": "var(--wp--preset--color--tnys-neutral)"
                },
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "color": {
                            "text": "var(--wp--preset--color--tnys-neutral)"
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "spacing": {
                    "margin": {
                        "bottom": "0px",
                        "top": "5px"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tnys-small)"
                }
            },
            "core/comment-content": {
                "spacing": {
                    "margin": {
                        "bottom": "var(--wp--preset--spacing--tnys-30)",
                        "top": "var(--wp--preset--spacing--tnys-30)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tnys-medium)"
                }
            },
            "core/comment-date": {
                "color": {
                    "text": "var(--wp--preset--color--tnys-neutral-dark)"
                },
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--tnys-neutral-dark)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tnys-small)"
                }
            },
            "core/comment-edit-link": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--tnys-neutral-dark)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tnys-small)"
                }
            },
            "core/comment-reply-link": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--tnys-neutral-dark)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tnys-small)"
                }
            },
            "core/comments-pagination": {
                "spacing": {
                    "margin": {
                        "bottom": "var(--wp--preset--spacing--tnys-40)",
                        "top": "var(--wp--preset--spacing--tnys-40)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tnys-medium)"
                }
            },
            "core/comments-pagination-next": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tnys-medium)"
                }
            },
            "core/comments-pagination-numbers": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tnys-medium)"
                }
            },
            "core/comments-pagination-previous": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tnys-medium)"
                }
            },
            "core/list": {
                "css": "& li{margin-top: 0.5rem;}"
            },
            "core/navigation": {
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tnys-medium)"
                }
            },
            "core/paragraph": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--manrope)",
                    "fontSize": "var(--wp--preset--font-size--tnys-medium)",
                    "fontWeight": "400",
                    "lineHeight": "1.5"
                },
                "color": {
                    "text": "var(--wp--preset--color--tnys-bermuda-gray-dark)"
                }
            },
            "core/post-comments-form": {
                "css": "& textarea, input:not([type=submit]){border-radius:.25rem; border-color: var(--wp--preset--color--tnys-neutral-lighter) !important;} & input[type=checkbox]{margin:0 .2rem 0 0 !important;} & label {font-size: var(--wp--preset--font-size--tnys-small); }",
                "spacing": {
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--tnys-40)",
                        "top": "var(--wp--preset--spacing--tnys-40)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tnys-medium)"
                }
            },
            "core/post-date": {
                "color": {
                    "text": "var(--wp--preset--color--tnys-neutral)"
                },
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "color": {
                            "text": "var(--wp--preset--color--tnys-neutral)"
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tnys-small)"
                }
            },
            "core/post-navigation-link": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tnys-medium)"
                }
            },
            "core/post-terms": {
                "css": "& a { white-space: nowrap; }",
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tnys-small)",
                    "fontWeight": "600"
                }
            },
            "core/post-title": {
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "none"
                            }
                        },
                        "typography": {
                            "fontWeight": "300",
                            "lineHeight": "1.2",
                            "textDecoration": "none"
                        }
                    }
                }
            },
            "core/pullquote": {
                "css": "& p:last-of-type {margin-bottom: var(--wp--preset--spacing--tnys-30);}",
                "elements": {
                    "cite": {
                        "typography": {
                            "fontSize": "var(--wp--preset--font-size--tnys-small)",
                            "fontStyle": "normal"
                        }
                    }
                },
                "spacing": {
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--tnys-30)",
                        "top": "var(--wp--preset--spacing--tnys-30)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tnys-heading-four)",
                    "fontWeight": "300",
                    "lineHeight": "1.2"
                }
            },
            "core/query-pagination": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tnys-medium)",
                    "fontWeight": "500"
                }
            },
            "core/quote": {
                "border": {
                    "color": "currentColor",
                    "style": "solid",
                    "width": "0 0 0 2px"
                },
                "css": "&.has-text-align-right { border-width: 0 2px 0 0; } &.has-text-align-center { border-width: 0;border-inline: 0; padding-inline: 0; }",
                "elements": {
                    "cite": {
                        "css": "& sub { font-size: 0.65em }",
                        "typography": {
                            "fontSize": "var(--wp--preset--font-size--tnys-small)",
                            "fontStyle": "normal",
                            "fontWeight": "300"
                        }
                    }
                },
                "spacing": {
                    "blockGap": "var(--wp--preset--spacing--tnys-30)",
                    "margin": {
                        "left": "0",
                        "right": "0"
                    },
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--tnys-30)",
                        "left": "var(--wp--preset--spacing--tnys-40)",
                        "right": "var(--wp--preset--spacing--tnys-40)",
                        "top": "var(--wp--preset--spacing--tnys-30)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tnys-large)",
                    "fontWeight": "300"
                },
                "variations": {
                    "plain": {
                        "border": {
                            "color": "transparent",
                            "radius": "0",
                            "style": "none",
                            "width": "0"
                        },
                        "spacing": {
                            "padding": {
                                "bottom": "0",
                                "left": "0",
                                "right": "0",
                                "top": "0"
                            }
                        }
                    }
                }
            },
            "core/search": {
                "css": "& .wp-block-search__input{border-radius:3.125rem;padding-left:1.5625rem;padding-right:1.5625rem;border-color:var(--wp--preset--color--tnys-neutral-lighter);}",
                "elements": {
                    "button": {
                        "border": {
                            "radius": "3.125rem"
                        },
                        "spacing": {
                            "margin": {
                                "left": "1.125rem"
                            }
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tnys-medium)",
                    "lineHeight": "1.6"
                }
            },
            "core/separator": {
                "border": {
                    "color": "currentColor",
                    "style": "solid",
                    "width": "0 0 1px 0"
                },
                "color": {
                    "text": "var(--wp--preset--color--tnys-neutral-lighter)"
                },
                "variations": {
                    "wide": {
                        "css": " &:not(.alignfull){max-width: var(--wp--style--global--wide-size) !important;}"
                    }
                }
            },
            "core/site-tagline": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tnys-medium)"
                }
            },
            "core/site-title": {
                "elements": {
