{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "tnys/slide",
  "version": "0.0.1",
  "title": "Slide",
  "category": "tnys",
  "description": "One slide of a carousel. Add any blocks inside it.",
  "parent": [
    "tnys/carousel"
  ],
  "supports": {
    "html": false,
    "reusable": false,
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "spacing": {
      "padding": true,
      "blockGap": true
    },
    "dimensions": {
      "minHeight": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true,
    "layout": {
      "default": {
        "type": "flex",
        "orientation": "vertical",
        "justifyContent": "stretch"
      },
      "allowSwitching": false,
      "allowOrientation": false,
      "allowInheriting": false
    }
  },
  "attributes": {
    "imageId": {
      "type": "number"
    },
    "imageUrl": {
      "type": "string"
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    },
    "imagePosition": {
      "type": "string",
      "default": "50% 50%"
    },
    "shade": {
      "type": "boolean",
      "default": false
    }
  },
  "textdomain": "tiny-steps",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}